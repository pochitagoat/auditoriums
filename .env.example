# Только пример. Скопируйте в .env и задайте свой пароль локально.
POSTGRES_DB=auditoriums_db
POSTGRES_USER=auditoriums
POSTGRES_PASSWORD=replace-with-your-password
POSTGRES_PORT=5433
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
APP_TIME_ZONE=Europe/Moscow
# seed допустим только для одноразовой пустой БД разработки. (APP_PROFILE=seed) если нужно
APP_PROFILE=default
